# Copy to .env.local and fill in. Never commit .env.local.

# Neon: Console → project → Connect.
# DATABASE_URL: pooled, as the restricted role bottega_app (row-level security
# applies; ARCHITECTURE §11). DATABASE_URL_UNPOOLED: the owner role, for
# pipeline/ and migrate.py only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth: Console → Auth → Configuration. Secret: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Access is decided in the database (accounts, shares); ALLOWED_EMAILS and
# ADMIN_EMAILS are no longer read.

# Cloudflare R2 (ARCHITECTURE §12). A token for Bottega alone, limited to its
# buckets. Neither bucket has public access. Each needs a CORS rule allowing
# PUT (header content-type) from every origin Bottega runs on.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_AUDIO_BUCKET=
# Every other upload: gear files, project images, private documents, library
# manuals (ARCHITECTURE §12). Needs the same CORS rule as the audio bucket.
R2_FILES_BUCKET=

# Only while scripts/migrate_from_vivarium.py runs: the Sirsinate instance's
# SUPABASE_DB_URL. Delete the line afterwards.
# VIVARIUM_DB_URL=
