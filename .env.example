# Copy to .env.local and fill in. Never commit .env.local.

# Neon: Console → project → Connect.
# DATABASE_URL: pooled, as the restricted role bottega_app (row-level security
# applies; ARCHITECTURE §11). DATABASE_URL_UNPOOLED: the owner role, for
# pipeline/ and migrate.py only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth: Console → Auth → Configuration. Secret: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Access is decided in the database (accounts, shares); ALLOWED_EMAILS and
# ADMIN_EMAILS are no longer read.

# Cloudflare R2. Same account, token and audio bucket as Vivarium's Sirsinate
# instance: copy the values from that clone's .env.local. The audio bucket's
# CORS rule must allow PUT from every origin Bottega runs on (localhost:3000
# now, the production address later).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_AUDIO_BUCKET=

# Only while scripts/migrate_from_vivarium.py runs: the Sirsinate instance's
# SUPABASE_DB_URL. Delete the line afterwards.
# VIVARIUM_DB_URL=
